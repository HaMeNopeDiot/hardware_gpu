    [#rect(image("vkcube1.png", height: 73%))]
  )

]

#slide[
  #grid(
    columns: 2,
    gutter: 1em,
    [== Отладочная информация интерпретатора], grid.cell(rowspan: 2)[#image("interpret_result.png")],
    [#text(size: 18pt)[Выполняя инструкции, интерпретатор печатал информацию об инструкции, список используемых аргументов и значение переменной, по номеру которой необходимо сохранить результат инструкции]]
  )
]

#slide[
  == Численные результаты моделирования
  #table(
    columns: 4,
    fill: white,
    align: center + horizon,
    table.header([Драйвер], [Нагрузка центрального процессора, %], [Нагрузка графического ускорителя, %], [Кадры в секунду]),
    table.cell(align: left)[video-nvidia-470xx],                  [20], [50], [60],
    table.cell(align: left)[Mesa3D#linebreak()lavapipe],          [40], [90], [140],
    table.cell(align: left)[Mesa3D#linebreak()интерпретатор NIR], [70], [50], [10],
  )
]

#slide[
  = Заключение
  Была достигнута поставленная задача разработать интерпретатор промежуточного представления NIR.

  Это позволяет отлаживать поведение RTL-описания и дает возможность сравнивать полученные результаты
  с желаемыми.
]

