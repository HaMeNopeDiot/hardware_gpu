// package for creating presentations
#import "@preview/polylux:0.4.0": *


// make the paper dimensions fit for a presentation and the text larger
#set page(
  paper: "presentation-16-9",
  fill: gradient.linear(white, white, white, aqua, angle: 270deg),
  header: context [
    #grid(
      inset: (top: 5mm),
      columns: (60%, 40%),
      align: (left, right),
      image("vsu_logo.png"),
      image("amm_logo.png")
    )
  ],
  footer: context [
    #set align(right)
    #set text(size: 14pt, fill: rgb("fdfdfd"))
    #rect(fill: rgb("444453"), width: 100%)[#counter(page).display("1")]
  ]
)

#set text(size: 14pt, font: "Times New Roman")

// title page
#slide[
  #set align(center + horizon)
  МИНОБРНАУКИ РОССИИ \
  ФЕДЕРАЛЬНОЕ ГОСУДАРСТВЕННОЕ БЮДЖЕТНОЕ \
  ОБРАЗОВАТЕЛЬНОЕ УЧРЕЖДЕНИЕ ВЫСШЕГО ОБРАЗОВАНИЯ \
  «ВОРОНЕЖСКИЙ ГОСУДАРСТВЕННЫЙ УНИВЕРСИТЕТ» \
  (ФГБОУ ВО «ВГУ»)

  Факультет прикладной математики, информатики и механики \
  Кафедра вычислительной математики \
  и прикладных информационных технологий

  #v(1fr)

  *Разработка аппаратной реализации 2D графического ускорителя.#linebreak()
  Интерпретатор промежуточного представления NIR*

  #v(1fr)

  Магистерская диссертация

  Направление 01.04.02 Прикладная математика и информатика

  #v(1fr)

  Обучающийся #h(1fr) И.А. Дудкин#linebreak()
  Руководитель #h(1fr) к.т.н., доц. О.В. Авсеева
  
  #v(1fr)

  Воронеж 2026
]

#set text(size: 26pt)
#set par(justify: true)

#slide[
  #set text(size: 20pt)
  #outline(
    title: [Структура доклада]
  )
]

#slide[
  = Актуальность
  #grid(
    columns: 2,
    rows: 2,
    gutter: 1em,
    image("hqdisplay.png", height: 40%),
    grid.cell(rowspan: 2)[#text(size: 26pt)[
        - Решение задач отрисовки графики (в том числе для встраиваемых решений)
        - Ускорение обучения нейронных сетей
      ]
    ],
    image("hqdisplay1.png", height: 40%),
  )

]

#slide[
  = Постановка задачи
  Для отладки RTL-реализации графического ускорителя необходимо иметь
  возможность пошагово сравнивать поведение RTL-описания и ожидаемое поведение.
  В связи с данным требованием была поставлена задача
  разработать интерпретатор промежуточного представления NIR.
]

#slide[
  = Проблема гетерогенности системы
  Большое разнообразие инструментов разработки, архитектур и необходимость поддерживать все из них 
  приводит к значительному усложнению разработки.
  // #set text(size: 18pt)
  // #table(
  //   columns: 2,
  //   [API],                      [Vulkan, OpenGL, DirectX, Metal],
  //   [Языки описания шейдеров],  [GLSL, HLSL, MSL],
  //   [Версии API],               [Vulkan 1.0-1.3, OpenGL 2.0-4.6, DX10-12, Metal 1.0-3.0],
  //   [Модели исполнения],        [Graphics Compute, Ray Tracing],
  //   [Аппаратные платформы],     [PC, игровые консоли, мобильные устройства, встариваемые системы],
  // )
]

#slide[
  == Неоднородность системы
  #align(center, image("geterogenus_problem.svg", height: 88%))
]

#slide[
  = Промежуточное представление

  #align(center, image("byte_code.png"))

]

#slide[
  = Поток данных в конвейере Mesa

  На рисунке ниже изображен поток данных в конвейере Mesa3D.

  #image("data_pipeline.svg", width: 100%)
]

#slide[
  = Интерпретатор промежуточного представления
  #v(1fr)
  #grid(
    columns: 2,
    rows: 2,
    gutter: 2em,
    [Было:],  [#image("with_llvm.svg")],
    [Стало:], [#image("with_interpreter.svg")],
  )
  #v(1fr)
]

#slide[
  = Результаты проделанной работы
  На рисунке ниже представлен пример работы приложения vkcube, запущенного через 
  интерпретатор промежуточного представления.

  #align(center, image("vkcube.png", height: 54%))
]

#slide[
  = Заключение
  Была достигнута поставленная задача разработать интерпретатор промежуточного представления NIR.
  Это позволяет отлаживать поведение RTL-описания и дает возможность сравнивать полученные результаты
  с желаемыми.
]

