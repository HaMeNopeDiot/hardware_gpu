// package for creating presentations
#import "@preview/polylux:0.4.0": *

// package for inserting source code
#import "@preview/codelst:2.0.2": sourcecode


// make the paper dimensions fit for a presentation format and the text larger
#set page(
  paper: "presentation-16-9",
  fill: gradient.linear(white, white, white, white, aqua, angle: 90deg),
  header: context [
    #grid(
      inset: (top: 5mm),
      columns: (60%, 40%),
      align: (left, right),
      image("vsu_logo.png"),
      image("amm_logo.png")
    )
  ],
  footer: context [
    #set align(right)
    #set text(size: 14pt, fill: rgb("000000"))
    #counter(page).display("1")
  ]
)

#set text(size: 14pt, font: "Times New Roman")

// title page
#slide[
  #set align(center + horizon)
  МИНОБРНАУКИ РОССИИ \
  ФЕДЕРАЛЬНОЕ ГОСУДАРСТВЕННОЕ БЮДЖЕТНОЕ \
  ОБРАЗОВАТЕЛЬНОЕ УЧРЕЖДЕНИЕ ВЫСШЕГО ОБРАЗОВАНИЯ \
  «ВОРОНЕЖСКИЙ ГОСУДАРСТВЕННЫЙ УНИВЕРСИТЕТ» \
  (ФГБОУ ВО «ВГУ»)

  Факультет прикладной математики, информатики и механики \
  Кафедра вычислительной математики \
  и прикладных информационных технологий

  #v(1fr)

  *Разработка ядра упрощенного графического ускорителя.#linebreak()
  Интерпретатор промежуточного представления*

  #v(1fr)

  Магистерская диссертация

  Направление 01.04.02 Прикладная математика и информатика

  #v(1fr)

  Обучающийся #h(1fr) И.А. Дудкин#linebreak()
  Руководитель #h(1fr) к.т.н., доц. О.В. Авсеева

  #v(1fr)

  Воронеж 2026
]

#set text(size: 26pt)
#set par(justify: true)

#slide[
  = Актуальность
  #grid(
    columns: 2,
    rows: 2,
    gutter: 1em,
    image("hqdisplay.png", height: 40%),
    grid.cell(rowspan: 2)[#text(size: 20pt)[
        - Решение задач отрисовки графики (в том числе для встраиваемых решений)
        - Ускорение обучения моделей интеллектуальных нейронных сетей
        - Отсутствие открытых источников с детальной информацией о внутреннем устройстве современных графических ускорителей с архитектурой унифицированных вычислительных ядер
      ]
    ],
    image("hqdisplay1.png", height: 40%),
  )
]

#slide[
  = Комплексная структура проекта
  #align(center, image("project_structure.svg", height: 80%))
]

#slide[
  = Цель и задачи
  Цель:
  - Разработать интерпретатор промежуточного представления NIR

  Задача:
  - Изучить устройство драйвера Mesa3D
  - Изучить архитектуру промежуточного представления NIR
  - Разработать интерпретатор промежуточного представления NIR на языке С
  - Проверить работу интерпретатора на примере запуска реального приложения
]

#slide[
  = Проблема гетерогенности системы
  Большое разнообразие инструментов разработки, архитектур и необходимость поддерживать все из них
  приводит к значительному усложнению разработки.
]

#slide[
  == Неоднородность системы
  #align(center, image("geterogenus_problem.svg", height: 88%))
]

#slide[
  = Пакет драйверов Mesa3D

  #grid(
    columns: 2,
    align: (left, right),
    gutter: 1em,
    [Преимущества Mesa3D:
    - Используется и поддерживается ведущими мировыми разработчиками (AMD, Intel, Nvidia, Qualcomm)
    - Решает проблему с многообразием API и архитектур
    - Свободная лицензия],
    [#image("Mesa3D_logo.svg", height: 80%)]
  )
]

#slide[
  = Поток данных в конвейере Mesa3D
  #v(1fr)
  #image("data_pipeline.svg", width: 100%)
  #v(1fr)
]

#slide[
  = Промежуточное представление

  #align(center, image("byte_code.png"))
]

#slide[
  #show raw: set text(size: 5pt)
  = Извлечение данных
  Чтобы разобраться с принципами работы Mesa3D использовалась утилита KCacheGrind
  #align(center, grid(
    columns: (70%, 30%),
    align: (left, left),
    image("kcachegrind.png", height: 65%),
    sourcecode(numbering: none, ```
    // draw->pt.user.vbuffer contents
    // modelView
    3f4b31a9 3e93aaf9 3f0919eb 0
    3e39677b 3f3a7fc5 bf2921d0 0
    bf14a8f3 3f1f1169 3f06a937 0
    0 0 c1000000 3f800000

    // modelViewProjection
    3fd9b535 3f52f43f bfab6066 bf0919eb
    3ec6a5ba 400536b1 3fd36a44 3f2921d0
    bf9f474d 3fe33d72 bfa85385 bf06a937
    0 0 40a00000 41000000

    // normals are laid as 3 vec4 instances
    3f4b31a9 3e93aaf9 3f0919eb 0
    3e39677b 3f3a7fc5 bf2921d0 0
    bf14a8f3 3f1f1169 3f06a937 0

    // vVertices
    // front
    bf800000 bf800000 3f800000
    3f800000 bf800000 3f800000
    bf800000 3f800000 3f800000
    3f800000 3f800000 3f800000
    //back
    3f800000 bf800000 bf800000
    bf800000 bf800000 bf800000
    3f800000 3f800000 bf800000
    bf800000 3f800000 bf800000
    // right
    3f800000 bf800000 3f800000
    3f800000 bf800000 bf800000
    3f800000 3f800000 3f800000
    3f800000 3f800000 bf800000
    ```)
  ))
]

